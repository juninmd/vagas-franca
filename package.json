{
  "name": "vagas-franca",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Radar diário de vagas de emprego em Franca-SP via Telegram (Gupy + portais + notícias, salário/jornada extraídos com IA, pt-BR).",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts --loop",
    "ingest": "bun run src/index.ts --ingest",
    "digest": "bun run src/index.ts --digest",
    "smoke": "bun run src/smoke.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "web": "bun run src/server.ts",
    "web:install": "cd web && bun install --frozen-lockfile",
    "web:build": "cd web && bun run build",
    "web:dev": "cd web && bun run dev"
  },
  "dependencies": {
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/bun": "^1.2.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.7.3"
  }
}
