# ── AI Provider: litellm | ollama | openai | anthropic | google ──
AI_PROVIDER=litellm

# LiteLLM do cluster (padrão — barato/centralizado)
LITELLM_BASE_URL=http://litellm.ai.svc.cluster.local:4000/v1
LITELLM_API_KEY=
LITELLM_MODEL=cloud/gemma3

# Ollama local (fallback offline)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Google Gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# ── Telegram (obtenha o chat id em @userinfobot) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=123456789
# Espaçamento entre mensagens: o Telegram corta em ~20/min por grupo e o digest
# manda uma mensagem por área. 3500ms = ~17/min, abaixo do corte.
TELEGRAM_INTERVAL_MS=3500

# ── Cron. CRON_TZ define o fuso das expressões abaixo (padrão UTC, que é o que
#    elas já assumem). Com CRON_TZ=America/Sao_Paulo dá pra escrever "0 8 * * *"
#    e ler como 8h da manhã. Digest 8h BRT = 11h UTC ──
CRON_TZ=UTC
CRON_INGESTION=0 */6 * * *
CRON_DIGEST=0 11 * * *

# ── Config ──
DB_PATH=./data/store.db
MAX_ITEMS_PER_FEED=20
ENRICH_MAX_JOBS=120
JOBS_PER_DIGEST=60
JOB_TTL_DAYS=21
PAGES_PER_BOARD=5
DETAIL_PAGES=12
FEED_TIMEOUT_MS=12000
# Teto por chamada de IA — sem ele um provider travado pendura o digest inteiro.
AI_TIMEOUT_MS=60000

# ── Segurança ──
# NUNCA use NODE_TLS_REJECT_UNAUTHORIZED=0: desliga a validação de certificado
# do processo inteiro, inclusive na chamada ao Telegram (que leva o token).
# Para certificado interno do cluster, use a CA específica:
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/cluster-ca.crt
